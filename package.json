{
  "name": "hook-relay",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@hook-relay/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate --filter=@hook-relay/web",
    "db:migrate": "turbo run db:migrate --filter=@hook-relay/web",
    "seed": "node scripts/seed.mjs",
    "load:test": "node scripts/load-test.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.6.3"
  }
}
