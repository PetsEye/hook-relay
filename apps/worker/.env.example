REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://hookrelay:hookrelay@localhost:5432/hookrelay
# Delivery tuning (defaults shown)
DELIVERY_TIMEOUT_MS=10000
WORKER_CONCURRENCY=10
# Backoff ladder in seconds; default 60,300,900,3600,21600 (1m→6h).
# Use e.g. RETRY_DELAYS_SEC=2,2,2,2,2 for fast local/e2e runs.
RETRY_DELAYS_SEC=60,300,900,3600,21600
